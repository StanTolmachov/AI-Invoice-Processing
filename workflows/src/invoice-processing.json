{
  "name": "AI Invoice Processing (Gmail → Gemini → Drive + Sheets + Slack)",
  "nodes": [
    {
      "id": "a1f0c0de-0001-4000-8000-000000000001",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [0, 300],
      "parameters": {
        "pollTimes": { "item": [{ "mode": "everyMinute" }] },
        "simple": false,
        "filters": { "q": "has:attachment (filename:pdf OR filename:jpg OR filename:jpeg OR filename:png) newer_than:2d" },
        "options": { "downloadAttachments": true, "dataPropertyAttachmentsPrefixName": "attachment_" }
      }
    },
    {
      "id": "a1f0c0de-0002-4000-8000-000000000002",
      "name": "Split attachments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300],
      "parameters": { "jsCode": "@file:split-attachments.js" }
    },
    {
      "id": "a1f0c0de-0003-4000-8000-000000000003",
      "name": "Prepare Gemini request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300],
      "parameters": { "jsCode": "@file:prepare-request.js" }
    },
    {
      "id": "a1f0c0de-0004-4000-8000-000000000004",
      "name": "Gemini extract",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.geminiBody) }}",
        "options": { "timeout": 120000 }
      }
    },
    {
      "id": "a1f0c0de-0005-4000-8000-000000000005",
      "name": "Validate & route",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 300],
      "parameters": { "jsCode": "@file:validate-route.js" }
    },
    {
      "id": "a1f0c0de-0006-4000-8000-000000000006",
      "name": "Is invoice?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1100, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "c0nd-0001",
              "leftValue": "={{ $json._status }}",
              "rightValue": "skipped",
              "operator": { "type": "string", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a1f0c0de-0007-4000-8000-000000000007",
      "name": "Ignore non-invoice",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1320, 480],
      "parameters": {}
    },
    {
      "id": "a1f0c0de-0008-4000-8000-000000000008",
      "name": "Upload to Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1320, 200],
      "parameters": {
        "name": "={{ $json.File }}",
        "driveId": { "__rl": true, "mode": "list", "value": "My Drive" },
        "folderId": { "__rl": true, "mode": "id", "value": "REPLACE_WITH_DRIVE_FOLDER_ID" },
        "inputDataFieldName": "data",
        "options": {}
      }
    },
    {
      "id": "a1f0c0de-0009-4000-8000-000000000009",
      "name": "Add Drive link",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 200],
      "parameters": { "mode": "runOnceForEachItem", "jsCode": "@file:add-drive-link.js" }
    },
    {
      "id": "a1f0c0de-0010-4000-8000-000000000010",
      "name": "Append to Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1760, 200],
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "mode": "id", "value": "REPLACE_WITH_SPREADSHEET_ID" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Invoices" },
        "columns": { "mappingMode": "autoMapInputData", "value": {}, "matchingColumns": [], "schema": [] },
        "options": { "handlingExtraData": "ignoreIt" }
      }
    },
    {
      "id": "a1f0c0de-0011-4000-8000-000000000011",
      "name": "Needs review?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1980, 200],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "c0nd-0002",
              "leftValue": "={{ $('Add Drive link').item.json._status }}",
              "rightValue": "needs_review",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a1f0c0de-0012-4000-8000-000000000012",
      "name": "Slack: review needed",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [2200, 120],
      "parameters": {
        "select": "channel",
        "channelId": { "__rl": true, "mode": "name", "value": "#invoices" },
        "text": "={{ (() => { const r = $('Add Drive link').item.json; return ':warning: *Invoice needs review*\\n*' + (r.Vendor || 'Unknown vendor') + '* · ' + (r['Invoice #'] || 'no number') + ' · ' + (r.Total ?? '?') + ' ' + (r.Currency || '') + '\\nIssues: ' + r.Flags + '\\nFile: ' + r['File Link'] + '\\nFrom: ' + r.From; })() }}",
        "otherOptions": { "includeLinkToWorkflow": false }
      }
    },
    {
      "id": "a1f0c0de-0013-4000-8000-000000000013",
      "name": "Auto-approved",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [2200, 300],
      "parameters": {}
    },
    {
      "id": "a1f0c0de-0014-4000-8000-000000000014",
      "name": "Setup notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-40, -80],
      "parameters": {
        "width": 660,
        "height": 300,
        "content": "## AI Invoice Processing\n**Setup (10 min)**\n1. Credentials: Gmail OAuth2, Google Drive + Sheets OAuth2, Slack, and *Header Auth* for Gemini (`x-goog-api-key` = your AI Studio key) on **Gemini extract**.\n2. Replace `REPLACE_WITH_DRIVE_FOLDER_ID` and `REPLACE_WITH_SPREADSHEET_ID`.\n3. Sheet tab **Invoices** with headers from `templates/invoices-header.csv`.\n4. Set *Settings → Error workflow* to **Invoice processing – error alert**.\n5. Activate. Dedupe memory works in active (production) runs."
      }
    },
    {
      "id": "a1f0c0de-0015-4000-8000-000000000015",
      "name": "Rules note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [840, -80],
      "parameters": {
        "width": 520,
        "height": 300,
        "color": 4,
        "content": "### The model extracts, code decides\n- quantity × price = amount, lines = subtotal, subtotal + tax = total, tax = rate\n- required fields, valid dates, ISO currency\n- duplicate vendor + invoice number\n- approval limit, credit notes, low confidence\n\nAny issue → **needs_review** + Slack. Failed AI call → row is still saved."
      }
    }
  ],
  "connections": {
    "Gmail Trigger": { "main": [[{ "node": "Split attachments", "type": "main", "index": 0 }]] },
    "Split attachments": { "main": [[{ "node": "Prepare Gemini request", "type": "main", "index": 0 }]] },
    "Prepare Gemini request": { "main": [[{ "node": "Gemini extract", "type": "main", "index": 0 }]] },
    "Gemini extract": { "main": [[{ "node": "Validate & route", "type": "main", "index": 0 }]] },
    "Validate & route": { "main": [[{ "node": "Is invoice?", "type": "main", "index": 0 }]] },
    "Is invoice?": {
      "main": [
        [{ "node": "Upload to Drive", "type": "main", "index": 0 }],
        [{ "node": "Ignore non-invoice", "type": "main", "index": 0 }]
      ]
    },
    "Upload to Drive": { "main": [[{ "node": "Add Drive link", "type": "main", "index": 0 }]] },
    "Add Drive link": { "main": [[{ "node": "Append to Sheets", "type": "main", "index": 0 }]] },
    "Append to Sheets": { "main": [[{ "node": "Needs review?", "type": "main", "index": 0 }]] },
    "Needs review?": {
      "main": [
        [{ "node": "Slack: review needed", "type": "main", "index": 0 }],
        [{ "node": "Auto-approved", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1", "saveManualExecutions": true },
  "pinData": {}
}
